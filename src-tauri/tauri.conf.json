{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Principal Prep",
  "version": "0.1.0",
  "identifier": "com.principal.prep",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Principal Prep — Active Recall",
        "width": 1120,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "RWRg4qXGrDl7O+UgVIeQAmcKUgNwekKOcb95OdtVwPk09F4+Nym64Nr8",
      "endpoints": [
        "https://github.com/REPLACE_ME/REPLACE_ME/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
